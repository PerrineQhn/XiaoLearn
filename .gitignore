# Global monorepo ignores for XiaoLearn

# OS / editors
.DS_Store
.fuse_hidden*
.idea/
.vscode/

# Root local tooling folders
.audio_cache/
.claude/
.venv_hsk/
.git_nested_backups/

# Dependencies
**/node_modules/

# Build outputs and framework caches
**/dist/
**/dist_validation/
**/build/
**/.astro/
**/.vite/
**/.cache/
**/.parcel-cache/
**/.next/
**/.nuxt/
**/.svelte-kit/
**/.expo/
**/web-build/
**/.turbo/

# Logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Environment files
**/.env
**/.env.*
**/.dev.vars
!**/.env.example
!**/.env.*.example

# Python
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/

# TypeScript
**/*.tsbuildinfo

# Test coverage
**/coverage/

# PDFs are local-only assets and must never be versioned
**/*.pdf

# Large local assets (kept locally, not versioned on GitHub)
xiaolearn_pdfs/manuel/mandarin_volume1_dictionary.pdf
xiaolearn_reference/新版HSK口语/新版HSK（三级）口语音频.wav
xiaolearn_reference/新版HSK口语/新版HSK（四级）口语音频.wav
xiaolearn_reference/新版HSK口语/新版HSK（五级）口语音频.wav
xiaolearn_reference/新版HSK口语/新版HSK（六级）口语音频.wav

# Generated caches/job files
xiaolearn_anki/audio_jobs*.json
xiaolearn_anki/*_cache_fr.json
xiaolearn_anki/anki_mandarin_myway.apkg
xiaolearn_app/scripts/*-audio-jobs.json
xiaolearn_app/data/translation-cache.json
xiaolearn_app/data/translation-zh-cache.json
xiaolearn_dictionnary/**/translation-cache.json
xiaolearn_dictionnary/**/translation-zh-cache.json

xiaolearn_app/exports/audio_cplayer
xiaolearn_pdfs/
xiaolearn_posts/

# Anki decks générés — trop volumineux pour GitHub
xiaolearn_anki/*.apkg

# Sources brutes des illustrations — 1,4 Go. Seuls les rendus optimisés
# (assets/avatars, assets/cards en .webp) sont versionnés ; ces PNG haute
# définition et la bibliothèque LPC servent à les régénérer, hors dépôt.
/avatar_sources/
/card_sources/
/lpc/

# Sorties intermédiaires des campagnes de relecture
/result_batch*.json

# Configurations Expo créées par erreur en lançant `eas` hors de
# xiaolearn_mobile/ : elles déclarent des projets fantômes. Le seul app.json
# qui compte est xiaolearn_mobile/app.json.
/app.json
/xiaolearn_app/app.json
/xiaolearn_app/functions/app.json
/xiaolearn_app/functions/eas.json
