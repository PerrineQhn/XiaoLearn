<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple : exigé par la guideline 4.8 dès lors que l'app
	     propose une connexion tierce (Google, ici). La capability doit aussi
	     être cochée sur l'App ID dans le portail développeur ; EAS le fait
	     automatiquement à la prochaine synchronisation des profils. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
