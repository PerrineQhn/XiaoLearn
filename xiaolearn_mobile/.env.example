# Copie ce fichier en .env et remplis tes valeurs Firebase
# (même projet que xiaolearn_app — consulte xiaolearn_app/.env ou la console Firebase)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ── Connexion Google (expo-auth-session) ──────────────────────────────────────
# Un client OAuth par plateforme, créés dans Google Cloud Console → Identifiants.
# Sans l'ID Android, le bouton « Continuer avec Google » est désactivé sur
# Android (il ne peut pas fonctionner) — l'e-mail reste disponible.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Ces variables ne sont PAS déclarées dans eas.json : le schéma y refuse les
# valeurs vides, et y écrire les vraies valeurs les versionnerait. Pour les
# builds EAS, passer par les variables d'environnement du projet :
#     eas env:create --name EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID --value ... \
#                    --environment production --visibility plaintext
# ou l'onglet « Environment variables » du tableau de bord Expo.

# ── RevenueCat — clés SDK PUBLIQUES, une par magasin ──────────────────────────
# Tableau de bord RevenueCat → Project settings → API keys.
#   iOS     : commence par « appl_ »
#   Android : commence par « goog_ »
# À ne pas confondre avec REVENUECAT_WEBHOOK_SECRET, qui est un secret SERVEUR
# consommé par la Cloud Function revenueCatWebhook et n'a rien à faire dans
# l'app : tout ce qui est préfixé EXPO_PUBLIC_ est embarqué dans le binaire.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
